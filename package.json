{
  "name": "reseter.css",
  "version": "3.0.0",
  "packageManager": "pnpm@10.15.0",
  "description": "The Modern CSS Reset 🚀",
  "main": "dist/index.min.css",
  "style": "dist/index.min.css",
  "exports": {
    ".": "./dist/index.min.css",
    "./mini": "./dist/mini.min.css",
    "./dist/index.css": "./dist/index.css",
    "./dist/index.min.css": "./dist/index.min.css",
    "./dist/mini.css": "./dist/mini.css",
    "./dist/mini.min.css": "./dist/mini.min.css",
    "./css/reseter.css": "./css/reseter.min.css",
    "./css/reseter.min.css": "./css/reseter.min.css",
    "./package.json": "./package.json"
  },
  "keywords": [
    "css",
    "css-reset",
    "reset-css",
    "normalize-css",
    "reset",
    "browser",
    "style",
    "reseter",
    "reseter.css"
  ],
  "homepage": "https://github.com/ikrishg/reseter.css#readme",
  "license": "MIT",
  "author": "Krish Gupta <krish@krishg.com> (https://github.com/ikrishg)",
  "bugs": {
    "url": "https://github.com/ikrishg/reseter.css/issues",
    "email": "krish@krishg.com"
  },
  "files": [
    "dist",
    "css",
    "src",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikrishg/reseter.css.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:css": "node scripts/build-css.js",
    "postbuild:css": "node scripts/copy-css-aliases.js",
    "compress": "bundlewatch --config .bundlewatch.config.js",
    "build": "pnpm run build:css && pnpm run compress",
    "prepack": "node scripts/copy-css-aliases.js",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "browserslist": "4.28.1",
    "brotli-size": "4.0.0",
    "bundlewatch": "0.4.1",
    "lightningcss": "1.33.0"
  }
}
