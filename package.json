{
  "name": "reseter.css",
  "version": "2.1.1",
  "description": "The Modern CSS Reset 🚀",
  "main": "dist/index.min.css",
  "style": "dist/index.min.css",
  "keywords": [
    "css",
    "css-reset",
    "reset-css",
    "normalize-css",
    "reset",
    "browser",
    "style",
    "reseter",
    "reseter.css"
  ],
  "homepage": "https://github.com/ikrishg/reseter.css#readme",
  "license": "MIT",
  "author": "Krish Gupta <krish@krishg.com> (https://github.com/ikrishg)",
  "bugs": {
    "url": "https://github.com/ikrishg/reseter.css/issues",
    "email": "krish@krishg.com"
  },
  "files": [
    "dist",
    "css",
    "src",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikrishg/reseter.css.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "compile": "sass src/index.scss dist/index.css --no-source-map",
    "postcompile": "sass src/mini.scss dist/mini.css --no-source-map",
    "prefix": "postcss dist/index.css -r --no-map -u autoprefixer",
    "postprefix": "postcss dist/mini.css -r --no-map -u autoprefixer",
    "minify": "cleancss dist/index.css -o dist/index.min.css",
    "postminify": "cleancss dist/mini.css -o dist/mini.min.css && node scripts/copy-css-aliases.js",
    "compress": "bundlewatch --config .bundlewatch.config.js",
    "build": "yarn compile && yarn prefix && yarn minify && yarn compress",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.3",
    "@semantic-release/npm": "12.0.1",
    "@semantic-release/release-notes-generator": "14.1.0",
    "autoprefixer": "10.4.27",
    "brotli-size": "4.0.0",
    "bundlewatch": "0.4.1",
    "clean-css-cli": "5.6.3",
    "postcss": "8.5.10",
    "postcss-cli": "11.0.1",
    "sass": "1.98.0",
    "semantic-release": "24.2.5"
  }
}
